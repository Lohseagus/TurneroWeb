# Copiar a /home/ubuntu/cheturno/.env en el servidor. NO commitear el .env real.
# El workflow no lo pisa. Si falta una variable obligatoria, el deploy se corta antes de tocar los contenedores.
DB_USERNAME=cambiar
DB_PASSWORD=cambiar

# Clave de firma de los tokens, en Base64 y de 32 bytes o más. Generala con: openssl rand -base64 48
# El backend no arranca si falta, si es corta o si es la clave de ejemplo que estuvo publicada en el repo.
JWT_SECRET=

# Contraseña de aplicación de la casilla que envía los mails (activación, recuperación, avisos).
# La imagen no trae ninguna. MAIL_USERNAME es opcional: por defecto soporte.cheturno@gmail.com.
MAIL_PASSWORD=
# MAIL_USERNAME=

# Solo para una instalación nueva, sin ningún SUPERADMIN: crea uno en el primer arranque.
# La contraseña necesita 12 caracteres o más. Después del primer login, borrá estas tres líneas.
# ADMIN_SEED_ENABLED=true
# ADMIN_SEED_EMAIL=
# ADMIN_SEED_PASSWORD=

# IMAGE_TAG no va acá. Lo escribe el deploy en image-tag.env (es el SHA de git).
