# Copiar a /home/ubuntu/cheturno/.env en el servidor. NO commitear el .env real.
# El workflow no lo pisa. Si falta una variable obligatoria, el deploy se corta antes de tocar los contenedores.
DB_USERNAME=cambiar
DB_PASSWORD=cambiar

# Clave de firma de los tokens, en Base64 y de 32 bytes o más. Generala con: openssl rand -base64 48
# El backend no arranca si falta, si es corta o si es la clave de ejemplo que estuvo publicada en el repo.
JWT_SECRET=

# IMAGE_TAG no va acá. Lo escribe el deploy en image-tag.env (es el SHA de git).
