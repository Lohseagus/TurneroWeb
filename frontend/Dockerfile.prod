# Imagen de producción del frontend.
# ng build --configuration production reemplaza environment.ts por environment.prod.ts
# (apiUrl: '/api'). Nginx solo sirve los estáticos: /api lo atiende Caddy.
FROM node:22-alpine AS build

WORKDIR /app

COPY cli/package.json cli/package-lock.json cli/.npmrc ./
RUN npm ci

COPY cli/ ./
ENV NODE_OPTIONS=--max-old-space-size=4096
RUN npm run build -- --configuration=production

# ngx_brotli no viene en la imagen oficial. Se compila contra la misma versión
# de nginx, con --with-compat, para poder cargarlo como módulo dinámico.
FROM nginx:alpine AS brotli

RUN apk add --no-cache \
      git \
      cmake \
      g++ \
      make \
      brotli-dev \
      pcre2-dev \
      zlib-dev \
      linux-headers \
      openssl-dev \
      wget

WORKDIR /tmp

RUN set -eux; \
    NGINX_VERSION="$(nginx -v 2>&1 | sed 's#.*/##')"; \
    wget -O nginx.tar.gz "https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz"; \
    tar -xzf nginx.tar.gz; \
    git clone --depth 1 https://github.com/google/ngx_brotli.git; \
    git -C ngx_brotli submodule update --init --recursive --depth 1; \
    cd "nginx-${NGINX_VERSION}"; \
    ./configure --with-compat --add-dynamic-module=/tmp/ngx_brotli; \
    make modules; \
    mkdir -p /out; \
    cp objs/ngx_http_brotli_filter_module.so /out/

FROM nginx:alpine

RUN apk add --no-cache brotli-libs \
    && mkdir -p /etc/nginx/modules

COPY --from=brotli /out/ngx_http_brotli_filter_module.so /etc/nginx/modules/ngx_http_brotli_filter_module.so

# load_module tiene que estar en el contexto main, antes de events/http.
RUN sed -i '1i load_module /etc/nginx/modules/ngx_http_brotli_filter_module.so;' /etc/nginx/nginx.conf

RUN rm -rf /usr/share/nginx/html/*

COPY --from=build /app/dist/cli/browser /usr/share/nginx/html
COPY nginx-custom.conf /etc/nginx/conf.d/default.conf

RUN nginx -t

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
