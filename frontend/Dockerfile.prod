# Imagen de producción del frontend.
# ng build --configuration production reemplaza environment.ts por environment.prod.ts
# (apiUrl: '/api'). Nginx solo sirve los estáticos: /api lo atiende Caddy.
FROM node:20-alpine AS build

WORKDIR /app

COPY cli/package.json cli/package-lock.json cli/.npmrc ./
RUN npm ci

COPY cli/ ./
ENV NODE_OPTIONS=--max-old-space-size=4096
RUN npm run build -- --configuration=production

FROM nginx:alpine

RUN rm -rf /usr/share/nginx/html/*

COPY --from=build /app/dist/cli/browser /usr/share/nginx/html
COPY nginx-custom.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
